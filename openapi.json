{
    "openapi": "3.1.0",
    "info": {
        "title": "OMS AI Service API - PT QA'OS Kreasi Indonesia",
        "description": "REST API layanan AI untuk ekstraksi teks percakapan WhatsApp berbasis LLM ke format JSON terstruktur dan estimasi durasi produksi berbasis Machine Learning.",
        "version": "1.0.0"
    },
    "paths": {
        "/health": {
            "get": {
                "tags": [
                    "System"
                ],
                "summary": "Health Check Layanan AI",
                "operationId": "health_check_health_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/extract-orders": {
            "post": {
                "tags": [
                    "Order Extraction"
                ],
                "summary": "Ekstrak Teks Percakapan WhatsApp ke JSON",
                "operationId": "extract_order_endpoint_api_v1_extract_orders_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ChatExtractRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ChatExtractResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Input teks kosong atau terlalu pendek",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Tidak ditemukan rincian produk pesanan dalam teks",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Kuota API LLM terlampaui (rate limit)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "Gangguan komunikasi dengan layanan LLM eksternal",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ChatExtractRequest": {
                "properties": {
                    "raw_chat": {
                        "type": "string",
                        "minLength": 10,
                        "title": "Raw Chat",
                        "description": "Raw copy-paste atau ringkasan percakapan dengan pelanggan di WhatsApp",
                        "examples": [
                            "Halo min, saya Budi Santoso dari PT Maju Bersama Sejahtera (081234567890). Mau order kaos combed 24s hitam sablon plastisol logo perusahaan di dada kiri (8x8 cm) + tulisan 'Family Gathering 2026' di punggung ukuran M 30, L 40, XL 15. Sama kaos hitam combed 24s sablon plastisol logo dada kiri aja M 10, L 20, XL 15. Kirim ke Jl. Sudirman Kav. 45, Gedung Graha Mandiri Lt. 8, Jakarta Selatan. Deadline 5 Desember 2026, udah deal harga nego via WA ya."
                        ]
                    }
                },
                "type": "object",
                "required": [
                    "raw_chat"
                ],
                "title": "ChatExtractRequest"
            },
            "ChatExtractResponse": {
                "properties": {
                    "customer_info": {
                        "$ref": "#/components/schemas/CustomerInfo"
                    },
                    "deadline_requested": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Deadline Requested",
                        "description": "Target tanggal selesai harus anda konversi ke dalam format YYYY-MM-DD jika disebutkan, atau null jika tidak disebutkan"
                    },
                    "items": {
                        "items": {
                            "$ref": "#/components/schemas/OrderItem"
                        },
                        "type": "array",
                        "title": "Items"
                    },
                    "notes": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Notes",
                        "description": "Catatan tambahan pesanan misal untuk acara apa"
                    }
                },
                "type": "object",
                "required": [
                    "customer_info",
                    "items"
                ],
                "title": "ChatExtractResponse",
                "example": {
                    "customer_info": {
                        "company_name": "PT Maju Bersama Sejahtera",
                        "customer_name": "Budi Santoso",
                        "phone_number": "081234567890",
                        "shipping_address": "Jl. Sudirman Kav. 45, Gedung Graha Mandiri Lt. 8, Jakarta Selatan"
                    },
                    "deadline_requested": "2026-12-05",
                    "items": [
                        {
                            "color": "Hitam",
                            "customization_notes": "Logo perusahaan di dada kiri (8x8 cm) + tulisan 'Family Gathering 2026' di punggung",
                            "customization_type": "Sablon Plastisol",
                            "material": "Cotton Combed 24s",
                            "product_type": "Kaos",
                            "size_breakdown": {
                                "L": 40,
                                "M": 30,
                                "XL": 15
                            }
                        },
                        {
                            "color": "Hitam",
                            "customization_notes": "Logo dada kiri",
                            "customization_type": "Sablon Plastisol",
                            "material": "Cotton Combed 24s",
                            "product_type": "Kaos",
                            "size_breakdown": {
                                "L": 20,
                                "M": 10,
                                "XL": 15
                            }
                        },
                        {
                            "color": "Navy",
                            "customization_notes": "Bordir logo dada kiri + bordir teks kecil di lengan kanan",
                            "customization_type": "Bordir Komputer",
                            "material": "Cotton Combed 24s",
                            "product_type": "Kaos Polo",
                            "size_breakdown": {
                                "L": 15,
                                "M": 10,
                                "XL": 5
                            }
                        },
                        {
                            "color": "Hitam-Putih",
                            "customization_notes": "Bordir logo di bagian depan tengah topi",
                            "customization_type": "Bordir Komputer",
                            "material": "Topi Jaring (Trucker)",
                            "product_type": "Topi",
                            "size_breakdown": {
                                "All Size": 50
                            }
                        }
                    ],
                    "notes": "Pesanan untuk acara Company Gathering akhir tahun. Sudah deal harga nego via WA."
                }
            },
            "CustomerInfo": {
                "properties": {
                    "customer_name": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Customer Name",
                        "description": "Nama Pelanggan/PIC Pesanan, null jika tidak disebutkan"
                    },
                    "company_name": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Company Name",
                        "description": "Nama Perusahaan/instansi/komunitas pelanggan, null jika tidak disebutkan"
                    },
                    "phone_number": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Phone Number",
                        "description": "Nomor Telepon Pelanggan, null jika tidak disebutkan"
                    },
                    "shipping_address": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Shipping Address",
                        "description": "Alamat pengiriman lengkap, null jika tidak disebutkan"
                    }
                },
                "type": "object",
                "title": "CustomerInfo"
            },
            "ErrorResponse": {
                "properties": {
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "default": "Error"
                    },
                    "detail": {
                        "type": "string",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "required": [
                    "detail"
                ],
                "title": "ErrorResponse"
            },
            "OrderItem": {
                "properties": {
                    "product_type": {
                        "type": "string",
                        "title": "Product Type",
                        "description": "Jenis Produk, misal: Kaos (Short Sleeve, Long Sleeve), Kaos Polo, Topi, Hoodie, Topi, Tas"
                    },
                    "material": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Material",
                        "description": "Jenis bahan, misal: Cotton Combed 24s, Lacoste CVC, Topi Jaring (Trucker)"
                    },
                    "color": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Color",
                        "description": "Warna produk, misal: Hitam Solid, Navy Tua, Hijau Army"
                    },
                    "customization_type": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Customization Type",
                        "description": "Jenis kustomisasi: Sablon Plastisol, Sablon DTF, Bordir Komputer, Polos"
                    },
                    "customization_notes": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Customization Notes",
                        "description": "\n        Detail posisi sablon: \n        1. jika pelanggan menyebutkan posisi di depan (dada kiri), maka isi key `customization_notes` dengan label 1\n        2. jika pelanggan menyebutkan posisi di depan (dada kiri) dan dengan ukuran A4 di belakang/punggung, maka isi key `customization_notes` dengan label 2\n        3. jika pelanggan menyebutkan posisi di depan (dada kiri) dan dengan ukuran A3 di belakang/punggung, maka isi key `customization_notes` dengan label 3\n        4. jika pelanggan menyebutkan posisi di depan saja (bukan di dada kiri) dengan ukuran 28x10 cm, maka isi key `customization_notes` dengan label 4\n        5. jika pelanggan menyebutkan posisi di depan saja (bukan di dada kiri) dengan ukuran A4, maka isi key `customization_notes` dengan label 5\n        6. jika pelanggan menyebutkan posisi di depan saja (bukan di dada kiri) dengan ukuran A3, maka isi key `customization_notes` dengan label 6\n        7. jika pelanggan menyebutkan posisi di depan dan belakang dengan ukuran A4, maka isi key `customization_notes` dengan label 7\n        8. jika pelanggan menyebutkan posisi di depan dengan ukuran A4 dan belakang dengan ukuran A3, maka isi key `customization_notes` dengan label 8\n        9. jika pelanggan menyebutkan posisi di depan dan belakang dengan ukuran A3, maka isi key `customization_notes` dengan label 9\n        "
                    },
                    "size_breakdown": {
                        "additionalProperties": {
                            "type": "integer"
                        },
                        "type": "object",
                        "title": "Size Breakdown",
                        "description": "Rincian jumlah per ukuran yang dipesan saja (misal {'M': 30, 'L': 40}) atau {'All Size': 50} untuk produk tanpa ukuran baju"
                    }
                },
                "type": "object",
                "required": [
                    "product_type",
                    "size_breakdown"
                ],
                "title": "OrderItem"
            }
        }
    }
}